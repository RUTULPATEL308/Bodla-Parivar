# ==============================================================================
# બોદલા પરિવાર (Bodla Parivar) - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit your real `.env` file to version control.
# 2. Never put Supabase service-role keys into the mobile client app.
# 3. Refer to docs/API_KEYS.md for full configuration details and fallback behaviors.
# ==============================================================================

# --- SUPABASE BACKEND (PostgreSQL, Auth, Storage, Edge Functions) ---
# Project URL obtained from Supabase project settings -> API
SUPABASE_URL=https://kjoykvxrnyykdnzektoj.supabase.co
# Anon / Public Key (Safe for Mobile App & Admin Client-side read/write with RLS)
SUPABASE_ANON_KEY=sb_publishable_PNb4_Epkaqv-J1KdC0x7dQ_-vxdAt-d
# Service Role Key (STRICTLY FOR ADMIN BACKEND EDGE FUNCTIONS ONLY, NEVER IN MOBILE APP)
SUPABASE_SERVICE_ROLE_KEY=postgresql://postgres:[Rutul@9824470026]@db.kjoykvxrnyykdnzektoj.supabase.co:5432/postgres

# --- MAPS & GEOCODING ---
# Map provider selection: 'google' | 'apple' | 'osm'
MAP_PROVIDER=osm
MAP_API_KEY=optional_google_maps_api_key_here

# --- FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS) ---
# Firebase project ID for server-side push notification dispatch
FCM_PROJECT_ID=your_firebase_project_id
FCM_SERVICE_ACCOUNT_KEY=your_fcm_service_account_json_path_or_secret

# --- APPLICATION SETTINGS ---
# Environment: development | staging | production
APP_ENV=development
ADMIN_BASE_URL=http://localhost:3000
ANALYTICS_ENABLED=false
CRASHLYTICS_ENABLED=false

# --- VILLAGE DEFAULT CONFIGURATION ---
VILLAGE_NAME_GU=બોદલા
VILLAGE_NAME_EN=Bodla
VILLAGE_DISTRICT=Mehsana
VILLAGE_STATE=Gujarat
VILLAGE_COUNTRY=India
VILLAGE_DEFAULT_LATITUDE=23.5880
VILLAGE_DEFAULT_LONGITUDE=72.3693
